{
  "name": "cotishama-backend",
  "version": "2.0.0",
  "description": "Cotishama Backend API - HonoJS + PostgreSQL",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir ../../dist --target bun",
    "start": "bun dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:reset": "bun run src/db/reset.ts",
    "db:seed": "bun run src/db/seeders/seed.ts",
    "lint": "biome lint src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.10.0",
    "date-fns": "^2.30.0",
    "drizzle-orm": "^0.29.0",
    "hono": "^3.10.0",
    "pg": "^8.11.0",
    "postgres": "^3.4.0",
    "pino": "^8.17.0",
    "pino-http": "^8.6.0",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.22.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^9.3.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
