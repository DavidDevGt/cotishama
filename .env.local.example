# Docker Compose Environment Variables
# Copy this file to .env and update with your actual credentials
# DO NOT commit this file to git

# ===== DATABASE CONFIGURATION =====
DB_NAME=cotishama_dev
DB_USER=cotishama_user
DB_PASSWORD=your_secure_postgres_password_here
DB_PORT=5432

# ===== REDIS CONFIGURATION =====
REDIS_PORT=6379

# ===== BACKEND APPLICATION =====
NODE_ENV=development
APP_PORT=3000
APP_HOST=0.0.0.0
LOG_LEVEL=debug

# ===== JWT SECRETS (Required for development) =====
JWT_SECRET=dev-secret-key-at-least-32-characters-minimum-required
JWT_REFRESH_SECRET=dev-refresh-key-at-least-32-characters-minimum-required

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Note: This file is safe for local development only.
# For production, use:
# - AWS Secrets Manager
# - HashiCorp Vault
# - Azure Key Vault
# - GitHub Secrets (for CI/CD)
# - Docker secrets (for Docker Swarm)
# - Kubernetes secrets (for Kubernetes)
