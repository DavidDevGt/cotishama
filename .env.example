# ===== APPLICATION =====
NODE_ENV=development
APP_PORT=3000
APP_HOST=0.0.0.0
LOG_LEVEL=info

# ===== DATABASE =====
# Docker compose variables (set these before running docker-compose)
DB_NAME=cotishama_dev
DB_USER=cotishama_user
DB_PASSWORD=CHANGEME_IN_PRODUCTION
DB_PORT=5432

# Connection string for application
DATABASE_URL=postgresql://cotishama_user:CHANGEME_IN_PRODUCTION@localhost:5432/cotishama_dev
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECT_TIMEOUT=10000

# ===== JWT SECURITY =====
JWT_SECRET=your-ultra-secure-jwt-secret-min-32-characters-required
JWT_REFRESH_SECRET=your-ultra-secure-refresh-secret-min-32-characters
JWT_ACCESS_EXPIRE=900000
JWT_REFRESH_EXPIRE=604800000

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.cotishama.com

# ===== PDF GENERATION =====
PDF_TIMEOUT=30000
HEADLESS_BROWSER=chrome

# ===== STORAGE =====
# Local (development)
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# S3 (production)
# STORAGE_TYPE=s3
# S3_BUCKET=cotishama-pdfs
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ===== EMAIL (OPTIONAL) =====
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SENDGRID_API_KEY=

# ===== REDIS (OPTIONAL) =====
# REDIS_URL=redis://localhost:6379

# ===== MONITORING =====
# SENTRY_DSN=
# DATADOG_API_KEY=
# NEW_RELIC_LICENSE_KEY=

# ===== FEATURE FLAGS =====
FEATURE_PDF_GENERATION=true
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_ADVANCED_REPORTS=false
