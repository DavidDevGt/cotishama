{
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "complexity": {
        "noUselessCatch": "warn"
      }
    },
    "ignore": ["**/node_modules", "dist", "coverage"]
  },
  "formatter": {
    "enabled": true,
    "indentWidth": 2,
    "lineWidth": 100,
    "indentStyle": "space",
    "lineEnding": "lf",
    "bracketSpacing": true,
    "ignore": ["**/node_modules", "dist", "coverage", ".env*"]
  },
  "organizeImports": {
    "ignore": ["**/node_modules", "dist", "coverage"]
  }
}

